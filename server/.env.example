# Used by docker-compose (env_file: ./server/.env)
MONGO_URI=mongodb://mongo:27017/ecommerce
PORT=8888
SECRET_ACCESS_TOKEN=replace_with_a_random_secret_access_token_at_least_32_chars
SECRET_REFRESH_TOKEN=replace_with_a_random_secret_refresh_token_at_least_32_chars
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_MOCK=false
REDIS_URL=redis://redis:6379
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=true
